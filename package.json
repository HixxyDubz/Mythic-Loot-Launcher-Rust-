{
  "name": "mythic-loot-launcher",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:player": "npm run build -- --mode player",
    "build:developer": "npm run build -- --mode developer",
    "check": "npm run test && npm run build",
    "verify:no-mock-data": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Verify-NoProductionMockData.ps1 -IncludeDist",
    "test": "vitest run",
    "preview": "vite preview",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Build-WindowsArtifacts.ps1 -Edition All",
    "package:windows:player": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Build-WindowsArtifacts.ps1 -Edition Player",
    "package:windows:developer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Build-WindowsArtifacts.ps1 -Edition Developer",
    "smoke:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Smoke-WindowsArtifacts.ps1",
    "smoke:app-update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Smoke-AppUpdateHelper.ps1",
    "smoke:live-app-update": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/Smoke-LiveAppUpdate.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.33.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
